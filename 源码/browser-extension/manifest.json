{
  "manifest_version": 3,
  "name": "梦藏 · 网页收录",
  "description": "保存网页、文章、高亮、图片和网页截图；在面板中查看个人库的相关资料。",
  "version": "0.3.0",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["activeTab", "scripting", "contextMenus", "nativeMessaging", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "保存到梦藏", "default_popup": "popup.html"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}
}
